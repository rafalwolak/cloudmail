{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudmail",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudmail-auth",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://example.com",
    "ADMIN_EMAIL": "",
    "AUTH_EMAIL_FROM": "",
    "ENABLE_SIGNUP": "false",
    "DELIVERY_QUEUE_NAME": "cloudmail-delivery-events"
  },
  "queues": {
    "consumers": [
      {
        "queue": "cloudmail-delivery-events"
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "r2_buckets": [
    {
      "binding": "INBOUND",
      "bucket_name": "cloudmail-inbound"
    }
  ]
}
